# Copy to deploy/.env and adjust. NEVER commit real secrets.

# ---- agentdox server ----
AGENTDOX_PORT=3003
AGENTDOX_AUTH_ENABLED=true
# Bootstrap admin PAT. Change this! You will use it to mint scoped tokens.
AGENTDOX_ADMIN_TOKEN=dev-admin-token-change-me
AGENTDOX_OIDC_ISSUER=http://localhost:8080/realms/agentdox
AGENTDOX_OIDC_CLIENT_ID=agentdox-server
AGENTDOX_OIDC_CLIENT_SECRET=agentdox-server-dev-secret
AGENTDOX_OIDC_AUDIENCE=

# ---- keycloak ----
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ---- production / NAS (compose.proxy.yml) ----
# DOMAIN=dox.example.com
# KEYCLOAK_HOSTNAME=auth.example.com
