{
  "name": "@agentdox/types",
  "version": "0.1.0",
  "description": "Shared TypeScript domain types for agentdox.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/drewappling/agentdox#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/drewappling/agentdox.git",
    "directory": "packages/types"
  },
  "bugs": {
    "url": "https://github.com/drewappling/agentdox/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
