{
  "name": "@agentdox/core",
  "version": "0.1.0",
  "description": "Storage (SQLite) plus memory/doc/context/session services and hybrid retrieval for agentdox.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/drewappling/agentdox#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/drewappling/agentdox.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/drewappling/agentdox/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@agentdox/auth": "^0.1.0",
    "@agentdox/types": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^5.5.4"
  }
}
