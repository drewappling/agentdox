{
  "name": "@agentdox/server",
  "version": "0.1.0",
  "description": "Fastify REST API and MCP-over-HTTP for agentdox.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agentdox-server": "./dist/index.js"
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/drewappling/agentdox#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/drewappling/agentdox.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/drewappling/agentdox/issues"
  },
  "keywords": ["agentdox", "server", "rest", "mcp", "memory", "context", "rag"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "dev": "tsx watch src/index.ts",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@agentdox/auth": "^0.1.0",
    "@agentdox/core": "^0.1.0",
    "@agentdox/mcp": "^0.1.0",
    "@agentdox/types": "^0.1.0",
    "@fastify/cors": "^10.0.1",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
